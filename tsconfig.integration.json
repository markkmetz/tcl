{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "outDir": "out",
    "rootDir": ".",
    "lib": ["es6"],
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["test/runTests.ts", "test/suite/**/*.ts"],
  "exclude": ["node_modules", ".vscode-test"]
}
